import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, CopyChip, DialogRow, DialogSection, Field, Modal, Progress } from "../primitives/modal.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";
import { Switch } from "../inspector/controls.slint";

// Long video: what the menu's Long video opens.
//
// An idea in, a cut timeline out. The sheet is the whole job, top to
// bottom: the idea and how long; who reads it; where the shots come from;
// the house style of the cut; the keys the services take. Then two
// buttons. Write script asks Claude for the storyboard and stops there, so
// it can be read - and edited, it is a file in the project folder - before
// a single shot is paid for. Create video does whatever is still missing,
// the script included, then lays the cut on a new timeline. While it runs
// the sheet is its progress report, as the speech sheets are.

export struct GenerateSheetData {
    open: bool,
    /// The idea, in the person's words.
    topic: string,
    /// Audience, tone, must-haves.
    notes: string,
    /// Row of the minutes list.
    minutes: int,
    /// Row of the clips list: none, a quarter, half, three quarters, all.
    clips: int,
    /// What the length and the mix come to before a word is written:
    /// chapters, scenes and voice lines, video and image prompts, words.
    budget: string,
    /// What it comes to in dollars, item by item, and whether that is over
    /// the limit.
    cost: string,
    /// The most a run may spend, as typed; empty for no limit.
    spend-limit: string,
    /// What a clip and a still cost, as typed; empty for the defaults.
    clip-price: string,
    image-price: string,
    /// Row of the language list.
    language: int,
    /// 0 16:9, 1 9:16, 2 1:1
    aspect: int,
    /// 0 none, 1 Concat's own voices, 2 ElevenLabs
    voice: int,
    /// 0 draft cards, 1 Replicate, 2 made by hand
    shots: int,
    /// Row of the music list; 0 is none.
    music: int,
    captions: bool,
    titles: bool,
    anthropic-key: string,
    replicate-token: string,
    /// The video model; empty for stills only.
    replicate-model: string,
    /// The image model; empty for the default.
    replicate-image-model: string,
    /// Export the finished cut without being asked.
    auto-export: bool,
    elevenlabs-key: string,
    elevenlabs-voice: string,
    /// A storyboard is in the project folder for this idea.
    has-script: bool,
    /// What that storyboard holds, in words.
    script-summary: string,
    /// How far the job is: what is made and kept, and what comes next.
    status: string,
    running: bool,
    /// 0..1
    progress: float,
    /// What the run is doing, in words.
    stage: string,
    /// The step under way: 0 the script, 1 the narration, 2 the shots,
    /// 3 the cut.
    phase: int,
    /// The run reads its scenes aloud.
    voiced: bool,
    /// What the step under way is making, in the script's words.
    detail: string,
    /// The last shot made, shown while the next one is.
    has-preview: bool,
    preview: image,
    /// Shots made of how many: "4 / 10".
    counts: string,
    /// What the run has paid so far, in words; empty while nothing.
    spent: string,
    /// Why the last run failed, when it did.
    message: string,
}

// One step of a run, as the checklist shows it: waiting, under way (a dot
// circling the ring), done (a tick), or not part of this run.
component RunStep inherits HorizontalLayout {
    in property <string> label;
    /// 0 waiting, 1 under way, 2 done, 3 skipped
    in property <int> state;
    in property <string> note;

    spacing: 10px;
    height: 26px;

    VerticalLayout {
        alignment: center;

        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: root.state == 2 ? Theme.accent : transparent;
            border-width: root.state == 2 ? 0px : 1.5px;
            border-color: root.state == 1 ? Theme.accent-soft : Theme.line;

            if root.state == 2: Icon {
                x: 4px;
                y: 4px;
                glyph: Glyph.check;
                size: 12px;
                tint: Theme.on-accent;
                weight: 3;
            }

            if root.state == 1: Rectangle {
                property <angle> turn: animation-tick() / 1100ms * 360deg;
                x: 10px + 7.5px * Math.cos(self.turn) - 3px;
                y: 10px + 7.5px * Math.sin(self.turn) - 3px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.accent;
            }
        }
    }

    Text {
        horizontal-stretch: 1;
        text: root.label;
        color: root.state == 1 ? Theme.fg : root.state == 2 ? Theme.fg-muted : Theme.fg-dim;
        font-size: Theme.fs;
        font-weight: root.state == 1 ? Theme.weight-title : 400;
        vertical-alignment: center;
    }

    if root.note != "": Text {
        text: root.note;
        color: root.state == 1 ? Theme.accent : Theme.fg-dim;
        font-family: Theme.font-technical;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
    }
}

export component GenerateDialog inherits Modal {
    in property <GenerateSheetData> data;
    /// On a phone, which has no file manager to show the job's folder in.
    in property <bool> phone;
    /// "None", then every recording in the bin.
    in property <[string]> music-options;

    /// Which text: 0 topic, 1 notes, 2 Anthropic key, 3 Replicate token,
    /// 4 Replicate video model, 5 ElevenLabs key, 6 ElevenLabs voice,
    /// 7 Replicate image model, 8 spend limit, 9 price of a clip, 10 price
    /// of a still.
    callback text-edited(field: int, text: string);
    /// Which choice: 0 minutes, 1 language, 2 aspect, 3 voice, 4 shots,
    /// 5 music, 6 clips.
    callback choice-changed(field: int, index: int);
    /// Which switch: 0 captions, 1 titles, 2 export when done.
    callback toggled(field: int, on: bool);
    callback write-script();
    callback create();
    callback open-folder();
    callback edit-script();
    callback cancel();

    open: root.data.open;
    title: I18n.t("generate.longVideo");
    glyph: Glyph.sparkle;
    surface-width: 560px;
    surface-height: 680px;
    dismissable: !root.data.running;

    // The idea being typed, held apart from `data.topic` as the captions
    // sheet holds its script: re-seeded when the sheet opens, never while
    // it is being typed into.
    property <string> draft;
    property <bool> typing;
    changed data => {
        if (!root.typing) {
            root.draft = root.data.topic;
        }
    }
    init => { root.draft = root.data.topic; }

    VerticalLayout {
        if !root.data.running: Rectangle {
            vertical-stretch: 1;

            Flickable {
                content-height: form.preferred-height;

                form := VerticalLayout {
                    DialogSection {
                        first: true;
                        title: I18n.t("generate.idea");

                        Rectangle {
                            height: 88px;
                            border-radius: Theme.r;
                            background: Theme.well;
                            border-width: 1px;
                            border-color: idea.has-focus ? Theme.accent : Theme.line;
                            clip: true;

                            idea := TextInput {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                height: parent.height - 16px;
                                text <=> root.draft;
                                color: Theme.fg;
                                font-size: Theme.fs-lg;
                                single-line: false;
                                wrap: word-wrap;
                                selection-background-color: Theme.accent;
                                selection-foreground-color: Theme.on-accent;
                                changed has-focus => { root.typing = self.has-focus; }
                                edited => { root.text-edited(0, self.text); }
                                key-pressed(event) => {
                                    if (event.text == Key.Home) {
                                        self.set-selection-offsets(0, 0);
                                        return accept;
                                    }
                                    if (event.text == Key.End) {
                                        self.set-selection-offsets(1000000000, 1000000000);
                                        return accept;
                                    }
                                    return reject;
                                }
                            }

                            if root.draft == "" && !idea.has-focus: Text {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                text: I18n.t("generate.ideaPlaceholder");
                                color: Theme.fg-dim;
                                font-size: Theme.fs-lg;
                                wrap: word-wrap;
                            }
                        }

                        DialogRow {
                            label: I18n.t("generate.notes");
                            Field {
                                value: root.data.notes;
                                placeholder: I18n.t("generate.notesPlaceholder");
                                edited(text) => { root.text-edited(1, text); }
                            }
                        }

                        DialogRow {
                            label: I18n.t("generate.length");
                            Select {
                                options: ["1 min", "3 min", "5 min", "10 min", "15 min", "20 min", "30 min", "60 min"];
                                current: root.data.minutes;
                                changed(index) => { root.choice-changed(0, index); }
                            }
                        }

                        DialogRow {
                            label: I18n.t("generate.clips");
                            Select {
                                options: [I18n.t("generate.clipsNone"), "25%", "50%", "75%", "100%"];
                                current: root.data.clips;
                                changed(index) => { root.choice-changed(6, index); }
                            }
                        }

                        Text {
                            text: root.data.budget;
                            color: Theme.fg-dim;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                        }

                        Text {
                            text: root.data.cost;
                            color: Theme.fg-dim;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                        }

                        DialogRow {
                            label: I18n.t("generate.spendLimit");
                            Field {
                                value: root.data.spend-limit;
                                technical: true;
                                placeholder: I18n.t("generate.noLimit");
                                edited(text) => { root.text-edited(8, text); }
                            }
                        }

                        DialogRow {
                            label: I18n.t("generate.language");
                            Select {
                                options: ["العربية", "English", "Français", "Español", "Deutsch", "Türkçe", "Português", "Bahasa Indonesia", "हिन्दी", "اردو"];
                                current: root.data.language;
                                changed(index) => { root.choice-changed(1, index); }
                            }
                        }

                        DialogRow {
                            label: I18n.t("generate.frame");
                            SegmentedControl {
                                options: ["16:9", "9:16", "1:1"];
                                current: root.data.aspect;
                                changed(index) => { root.choice-changed(2, index); }
                            }
                        }

                        if root.data.has-script: HorizontalLayout {
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Icon { glyph: Glyph.check; size: 13px; tint: Theme.accent; }
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: root.data.script-summary;
                                color: Theme.fg-muted;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }

                            Button {
                                label: I18n.t("generate.editScript");
                                glyph: Glyph.text-mark;
                                clicked => { root.edit-script(); }
                            }

                            if !root.phone: Button {
                                label: I18n.t("generate.openFolder");
                                glyph: Glyph.folder;
                                ghost: true;
                                clicked => { root.open-folder(); }
                            }
                        }

                        // A wrapped line on its own: beside an icon, a
                        // layout row was given one line's height.
                        if root.data.has-script && root.data.status != "": Text {
                            text: root.data.status;
                            color: Theme.accent;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                        }
                    }

                    DialogSection {
                        title: I18n.t("generate.voice");

                        DialogRow {
                            label: I18n.t("generate.reader");
                            Select {
                                options: [I18n.t("generate.noVoice"), I18n.t("generate.concatVoices"), "ElevenLabs"];
                                current: root.data.voice;
                                changed(index) => { root.choice-changed(3, index); }
                            }
                        }

                        if root.data.voice == 1: Text {
                            text: I18n.t("generate.concatVoicesHint");
                            color: Theme.fg-dim;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                        }

                        if root.data.voice == 2: DialogRow {
                            label: I18n.t("generate.apiKey");
                            Field {
                                value: root.data.elevenlabs-key;
                                secret: true;
                                technical: true;
                                placeholder: "xi-...";
                                edited(text) => { root.text-edited(5, text); }
                            }
                        }

                        if root.data.voice == 2: DialogRow {
                            label: I18n.t("generate.voiceId");
                            Field {
                                value: root.data.elevenlabs-voice;
                                technical: true;
                                edited(text) => { root.text-edited(6, text); }
                            }
                        }
                    }

                    DialogSection {
                        title: I18n.t("generate.shots");

                        DialogRow {
                            label: I18n.t("generate.source");
                            Select {
                                options: [I18n.t("generate.draftCards"), I18n.t("generate.replicateMix"), I18n.t("generate.byHand")];
                                current: root.data.shots;
                                changed(index) => { root.choice-changed(4, index); }
                            }
                        }

                        Text {
                            text: root.data.shots == 0 ? I18n.t("generate.draftCardsHint")
                                : root.data.shots == 1 ? I18n.t("generate.replicateHint")
                                : I18n.t("generate.byHandHint");
                            color: Theme.fg-dim;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                        }

                        if root.data.shots == 1: DialogRow {
                            label: I18n.t("generate.apiKey");
                            Field {
                                value: root.data.replicate-token;
                                secret: true;
                                technical: true;
                                placeholder: "r8_...";
                                edited(text) => { root.text-edited(3, text); }
                            }
                        }

                        if root.data.shots == 1: DialogRow {
                            label: I18n.t("generate.imageModel");
                            Field {
                                value: root.data.replicate-image-model;
                                technical: true;
                                placeholder: "black-forest-labs/flux-schnell";
                                edited(text) => { root.text-edited(7, text); }
                            }
                        }

                        if root.data.shots == 1: DialogRow {
                            label: I18n.t("generate.videoModel");
                            Field {
                                value: root.data.replicate-model;
                                technical: true;
                                placeholder: "wan-video/wan-2.2-i2v-fast";
                                edited(text) => { root.text-edited(4, text); }
                            }
                        }

                        if root.data.shots == 1: DialogRow {
                            label: I18n.t("generate.clipPrice");
                            Field {
                                value: root.data.clip-price;
                                technical: true;
                                placeholder: "0.10";
                                edited(text) => { root.text-edited(9, text); }
                            }
                        }

                        if root.data.shots == 1: DialogRow {
                            label: I18n.t("generate.imagePrice");
                            Field {
                                value: root.data.image-price;
                                technical: true;
                                placeholder: "0.003";
                                edited(text) => { root.text-edited(10, text); }
                            }
                        }
                    }

                    DialogSection {
                        title: I18n.t("generate.cut");

                        DialogRow {
                            label: I18n.t("generate.music");
                            Select {
                                options: root.music-options;
                                current: root.data.music;
                                changed(index) => { root.choice-changed(5, index); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                horizontal-stretch: 1;
                                text: I18n.t("generate.captionsFromNarration");
                                color: Theme.fg;
                                font-size: Theme.fs;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: root.data.captions;
                                    toggled(on) => { root.toggled(0, on); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                horizontal-stretch: 1;
                                text: I18n.t("generate.exportWhenDone");
                                color: Theme.fg;
                                font-size: Theme.fs;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: root.data.auto-export;
                                    toggled(on) => { root.toggled(2, on); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                horizontal-stretch: 1;
                                text: I18n.t("generate.chapterTitles");
                                color: Theme.fg;
                                font-size: Theme.fs;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: root.data.titles;
                                    toggled(on) => { root.toggled(1, on); }
                                }
                            }
                        }
                    }

                    DialogSection {
                        title: I18n.t("generate.writer");
                        hint: I18n.t("generate.writerHint");

                        DialogRow {
                            label: "Claude";
                            Field {
                                value: root.data.anthropic-key;
                                secret: true;
                                technical: true;
                                placeholder: "sk-ant-...";
                                edited(text) => { root.text-edited(2, text); }
                            }
                        }
                    }
                }
            }
        }

        // While a run is under way the sheet is its stage: the last shot
        // made, the words of the one being made, the steps, and what it
        // has cost - and the reassurance that leaving loses nothing.
        if root.data.running: Rectangle {
            vertical-stretch: 1;

            Flickable {
                content-height: run.preferred-height;

                run := VerticalLayout {
                    padding: 16px;
                    spacing: 14px;

                    Rectangle {
                        height: Math.min(self.width * 9 / 16, 240px);
                        border-radius: Theme.r * 2;
                        background: Theme.well;
                        border-width: 1px;
                        border-color: Theme.line;
                        clip: true;

                        if root.data.has-preview: Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.data.preview;
                            image-fit: contain;
                        }

                        // Nothing to show yet: the mark breathes.
                        if !root.data.has-preview: Rectangle {
                            property <float> breath: (1 + Math.sin(animation-tick() / 1600ms * 360deg)) / 2;
                            width: 64px;
                            height: 64px;
                            border-radius: 32px;
                            background: Theme.accent-soft;
                            opacity: 0.45 + 0.55 * self.breath;

                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                glyph: Glyph.sparkle;
                                size: 26px + 6px * parent.breath;
                                tint: Theme.accent;
                            }
                        }

                        // A sheen sweeping across: the stage is at work.
                        Rectangle {
                            property <float> sweep: Math.mod(animation-tick() / 2200ms, 1);
                            x: (parent.width * 1.6) * self.sweep - parent.width * 0.6;
                            width: parent.width * 0.6;
                            height: parent.height;
                            background: @linear-gradient(90deg, #ffffff00 0%, #ffffff1f 50%, #ffffff00 100%);
                        }

                        if root.data.counts != "": Rectangle {
                            x: 10px;
                            y: 10px;
                            width: chip.preferred-width + 16px;
                            height: 22px;
                            border-radius: 11px;
                            background: #000000a0;

                            chip := Text {
                                text: root.data.counts;
                                color: #ffffff;
                                font-family: Theme.font-technical;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            horizontal-stretch: 1;
                            text: root.data.stage;
                            color: Theme.fg;
                            font-size: Theme.fs-lg;
                            font-weight: Theme.weight-title;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "\{Math.floor(root.data.progress * 100)}%";
                            color: Theme.accent;
                            font-family: Theme.font-technical;
                            font-size: Theme.fs-lg;
                            vertical-alignment: center;
                        }
                    }

                    Progress {
                        value: root.data.progress;
                        live: true;
                    }

                    if root.data.detail != "": Rectangle {
                        height: Math.min(words.preferred-height, 54px);
                        clip: true;

                        words := Text {
                            width: parent.width;
                            y: 0px;
                            text: "“" + root.data.detail + "”";
                            color: Theme.fg-muted;
                            font-size: Theme.fs-sm;
                            font-italic: true;
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;

                        RunStep {
                            label: I18n.t("generate.stepScript");
                            state: root.data.phase > 0 ? 2 : 1;
                        }

                        RunStep {
                            label: I18n.t("generate.stepVoice");
                            state: root.data.phase < 1 ? 0 : !root.data.voiced ? 3 : root.data.phase > 1 ? 2 : 1;
                            note: root.data.phase >= 1 && !root.data.voiced ? I18n.t("generate.noVoice") : "";
                        }

                        RunStep {
                            label: I18n.t("generate.stepShots");
                            state: root.data.phase < 2 ? 0 : root.data.phase == 2 ? 1 : 2;
                            note: root.data.counts;
                        }

                        RunStep {
                            label: I18n.t("generate.stepCut");
                            state: root.data.phase == 3 ? 1 : 0;
                        }
                    }

                    if root.data.spent != "": Text {
                        text: root.data.spent;
                        color: Theme.fg-muted;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs-sm;
                    }

                    if root.data.phase >= 1: HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            alignment: start;
                            Icon { glyph: Glyph.check; size: 13px; tint: Theme.fg-dim; }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: I18n.t("generate.keptNote");
                            color: Theme.fg-dim;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            if root.data.message != "": Rectangle {
                border-radius: Theme.r;
                background: Theme.danger-soft;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: start;
                        Icon { glyph: Glyph.close; size: 13px; tint: Theme.danger; }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.message;
                        color: Theme.danger;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        alignment: start;
                        CopyChip { text: root.data.message; }
                    }
                }
            }

            if root.data.running: HorizontalLayout {
                alignment: start;
                Button {
                    label: I18n.t("common.cancel");
                    glyph: Glyph.close;
                    ghost: true;
                    clicked => { root.cancel(); }
                }
            }

            if !root.data.running: HorizontalLayout {
                spacing: 8px;

                Button {
                    label: root.data.has-script ? I18n.t("generate.rewriteScript") : I18n.t("generate.writeScript");
                    glyph: Glyph.text-mark;
                    large: true;
                    enabled: root.draft != "";
                    clicked => { root.write-script(); }
                }

                Button {
                    horizontal-stretch: 1;
                    block: true;
                    primary: true;
                    large: true;
                    glyph: Glyph.film;
                    label: I18n.t("generate.createVideo");
                    enabled: root.draft != "" || root.data.has-script;
                    clicked => { root.create(); }
                }
            }
        }
    }
}
