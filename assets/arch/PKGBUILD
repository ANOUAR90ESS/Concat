# Maintainer: noxygalaxy <noxycraftyt@gmail.com>
pkgname=longcut
pkgver=${CONCAT_VERSION:?CONCAT_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
url="https://github.com/ANOUAR90ESS/Concat"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${CONCAT_STAGE:?CONCAT_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/concat" "$pkgdir/opt/longcut/concat"
  install -d "$pkgdir/opt/longcut/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/longcut/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/longcut/concat "$@"\n' > "$pkgdir/usr/bin/longcut"
  chmod 755 "$pkgdir/usr/bin/longcut"
  install -Dm644 "$stage/longcut.desktop" "$pkgdir/usr/share/applications/longcut.desktop"
  sed -i 's|^Exec=concat|Exec=/opt/longcut/concat %U|' "$pkgdir/usr/share/applications/longcut.desktop"
  install -Dm644 "$stage/longcut.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/longcut.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/longcut/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/longcut/THIRD_PARTY_NOTICES.md"
}
